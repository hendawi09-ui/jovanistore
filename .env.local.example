# انسخ القيم دي من إعدادات مشروعك على Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# كلمة سر لوحة التحكم (اسم المستخدم دايمًا admin)
ADMIN_PASSWORD=your-strong-password-here

# إشعارات الطلبات الجديدة عبر الإيميل (Resend.com)
RESEND_API_KEY=your-resend-api-key
NOTIFY_EMAIL=your-email@example.com

# إشعارات الطلبات الجديدة عبر واتساب (CallMeBot)
CALLMEBOT_PHONE=201xxxxxxxxx
CALLMEBOT_APIKEY=your-callmebot-apikey

# تسجيل الدخول بجوجل (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# تسجيل الدخول بفيسبوك (developers.facebook.com -> App settings -> Basic)
FACEBOOK_CLIENT_ID=your-facebook-app-id
FACEBOOK_CLIENT_SECRET=your-facebook-app-secret
