# انسخ القيم دي من إعدادات مشروعك على Supabase (Project Settings > API)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# كلمة سر لوحة التحكم (اسم المستخدم دايمًا admin)
ADMIN_PASSWORD=your-strong-password-here

# إشعارات الطلبات الجديدة عبر الإيميل (Resend.com)
RESEND_API_KEY=your-resend-api-key
NOTIFY_EMAIL=your-email@example.com

# إشعارات الطلبات الجديدة عبر واتساب (CallMeBot)
CALLMEBOT_PHONE=201xxxxxxxxx
CALLMEBOT_APIKEY=your-callmebot-apikey
